{
  "id": "lumina-calendar",
  "name": "Lumina Calendar",
  "short_name": "Lumina",
  "description": "A strikingly beautiful smart calendar for daily life — type events in plain English or Arabic, month/week/agenda views, reminders, repeating events, several calendars, folder sync, and it works offline.",
  "lang": "en",
  "dir": "auto",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0a0c",
  "theme_color": "#0a0a0c",
  "categories": [
    "productivity",
    "utilities",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
